# Provider selection
EVAL_PROVIDER=anthropic          # anthropic (default) | openai

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=            # uncomment for DeepSeek/Kimi/GLM-compatible endpoints

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=               # uncomment to override base URL

# Model override (optional — defaults to claude-opus-4-5 / gpt-4o per provider)
# MODEL_ID=claude-sonnet-4-5
